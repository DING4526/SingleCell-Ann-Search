# Flask/session configuration
SECRET_KEY=replace-with-a-long-random-secret

# Required before an administrator can save shared AI provider credentials.
# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AI_CREDENTIAL_ENCRYPTION_KEY=replace-with-generated-fernet-key

# Keep false for cloud providers. Set true only when intentionally using a
# trusted private/self-hosted OpenAI-compatible endpoint.
AI_ALLOW_PRIVATE_ENDPOINTS=false
AI_EXECUTOR_WORKERS=2

# Stage-two RAG and replayable stream defaults.
AI_KNOWLEDGE_MAX_FILE_MB=25
AI_KNOWLEDGE_MAX_PDF_PAGES=500
AI_STREAM_EVENT_RETENTION_HOURS=24
